# ============================================================
# FARMACIA DEM — Variables de Entorno del Backend
# Copiar este archivo como .env y completar los valores
# ============================================================

# Aplicación Django
DEBUG=True
SECRET_KEY=django-insecure-farmacia-dem-key-cambiar-en-produccion

# ─── Base de Datos PostgreSQL ────────────────────────────────
# Cambia estos valores por los de tu servidor PostgreSQL
DB_NAME=farmacia
DB_USER=postgres
DB_PASS=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# ─── WebServices de Bienestar Social ─────────────────────────
# 1. WebService de Bienestar Futuro (Búsqueda por POST con JSON)
# Dejar vacío si no está disponible — el sistema funciona sin él
# BIENESTAR_FUTURO_URL=

# 2. WebService de Bienestar Actual (Búsqueda por GET)
# Dejar vacío si no está disponible — el sistema funciona sin él
BIENESTAR_ACTUAL_URL=

# 3. Archivo de Simulación Local (Mock JSON)
# Dejar vacío si no está disponible — el sistema funciona sin él
BIENESTAR_MOCK_PATH=